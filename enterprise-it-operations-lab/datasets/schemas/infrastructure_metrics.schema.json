{
  "title": "Infrastructure Metrics",
  "type": "object",
  "required": [
    "timestamp",
    "hostname",
    "cpu_percent"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "hostname": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "cpu_percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "memory_used_percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "disk_used_percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "availability_percent": {
      "type": "number"
    }
  }
}