{
  "title": "Service Tickets",
  "type": "object",
  "required": [
    "ticket_id",
    "opened_at",
    "category",
    "priority",
    "status"
  ],
  "properties": {
    "ticket_id": {
      "type": "string",
      "pattern": "^TCK-"
    },
    "opened_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "category": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "P1",
        "P2",
        "P3",
        "P4"
      ]
    },
    "status": {
      "type": "string"
    },
    "resolution_minutes": {
      "type": "integer",
      "minimum": 0
    },
    "sla_met": {
      "type": "integer",
      "enum": [
        0,
        1
      ]
    }
  }
}